{
  "tiles_module": {
    "meta": {
      "name": "3DC Tile Specification",
      "version": "0.4",
      "coordinate_system": "board-centered",
      "units": "pixels",
      "spacing": 100
    },
    "grid": {
      "tile_spacing": { "z": 150, "xy": 100 },
      "origin": [0, 0, 0],
      "axes": {
        "z": "level (bottom to top; rook planes)",
        "x": "file (left-right from White POV)",
        "y": "rank (near-far from White POV)"
      }
    },
    "tile": {
      "size": {
        "height": 6,
        "width": 90,
        "depth": 90
      },
      "face": {
        "encoding": "bishop_color",
        "colors": {
          "white": "#f2f2f2",
          "black": "#d0d0d0"
        }
      },
      "edge": {
        "encoding": "duke_color",
        "colors": {
          "gold":   "#c9a227",
          "silver": "#c0c0c0",
          "ruby":   "#8b0000",
          "jade":   "#006400"
        }
      },
      "positioning": {
        "anchor": "bottom-center"
      }
    },
    "render": {
      "projection": "orthographic",
      "camera": {
        "default_pov": "white_shallow_angle",
        "tilt_degrees": 25,
        "rotation_enabled": true,
        "zoom_enabled": true,
        "jitter": {
          "enabled": true,
          "amplitude_degrees": 5,
          "speed": 0.2
        }
      },
      "visibility_constraints": {
        "minimize_occlusion": true,
        "preserve_lower_plane_visibility": true
      }
    },
    "interaction": {
      "clickable": true,
      "hover": true,
      "selection_mode": "toggle",
      "events": [
        "tile_selected",
        "tile_hover"
      ]
    },
    "debug": {
      "show_coordinates": false,
      "show_axes": false,
      "highlight_levels": false
    }
  }
}

